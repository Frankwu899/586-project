{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed VisualDetails extension; not a v0.3 API payload",
  "type": "object",
  "properties": {
    "subjects": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_analyzed",
            "observations",
            "none_found",
            "failed"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VisualSubject"
          }
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorInfo"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "items",
        "error"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "observations"
              }
            }
          },
          "then": {
            "properties": {
              "items": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "items": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "$ref": "#/$defs/ErrorInfo"
              }
            }
          },
          "else": {
            "properties": {
              "error": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "actions": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_analyzed",
            "observations",
            "none_found",
            "failed"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VisualAction"
          }
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorInfo"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "items",
        "error"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "observations"
              }
            }
          },
          "then": {
            "properties": {
              "items": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "items": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "$ref": "#/$defs/ErrorInfo"
              }
            }
          },
          "else": {
            "properties": {
              "error": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "product_presentations": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_analyzed",
            "observations",
            "none_found",
            "failed"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProductPresentation"
          }
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorInfo"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "items",
        "error"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "observations"
              }
            }
          },
          "then": {
            "properties": {
              "items": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "items": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "$ref": "#/$defs/ErrorInfo"
              }
            }
          },
          "else": {
            "properties": {
              "error": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "subjects",
    "actions",
    "product_presentations"
  ],
  "additionalProperties": false,
  "$defs": {
    "VisualSubject": {
      "type": "object",
      "properties": {
        "subject_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,63}$"
        },
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "person",
                "animal",
                "plant",
                "physical_object",
                "digital_interface",
                "graphic",
                "environment",
                "other"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "roles": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "product",
                  "presenter",
                  "product_user",
                  "context",
                  "other"
                ]
              },
              "minItems": 1,
              "uniqueItems": true,
              "allOf": [
                {
                  "if": {
                    "contains": {
                      "const": "other"
                    }
                  },
                  "then": {
                    "maxItems": 1
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "subject_id",
        "kind",
        "label",
        "description",
        "roles"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "kind": {
                    "const": "other"
                  }
                }
              },
              {
                "properties": {
                  "roles": {
                    "type": "array",
                    "contains": {
                      "const": "other"
                    }
                  }
                }
              }
            ]
          },
          "then": {
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      ]
    },
    "VisualAction": {
      "type": "object",
      "properties": {
        "action_type": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "hold",
                "pick_up",
                "put_down",
                "open",
                "close",
                "pour",
                "apply",
                "operate",
                "assemble",
                "disassemble",
                "wear",
                "eat_drink",
                "point",
                "move",
                "other"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "actor_subject_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,63}$"
          },
          "uniqueItems": true,
          "minItems": 0
        },
        "target_subject_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,63}$"
          },
          "uniqueItems": true,
          "minItems": 0
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "action_type",
        "actor_subject_ids",
        "target_subject_ids",
        "description"
      ],
      "additionalProperties": false
    },
    "ProductPresentation": {
      "type": "object",
      "properties": {
        "product_subject_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,63}$"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "presentation_type": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "appearance",
                "feature_demo",
                "use_case",
                "result_display",
                "comparison",
                "packaging",
                "unboxing",
                "other"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "product_subject_ids",
        "presentation_type",
        "description"
      ],
      "additionalProperties": false
    },
    "ErrorInfo": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": false
    }
  }
}
