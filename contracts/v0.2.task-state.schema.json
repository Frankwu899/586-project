{
  "$defs": {
    "AnalysisResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.2.0",
          "default": "0.2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "analysis_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,63}$",
          "title": "Analysis Id",
          "type": "string"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "task_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,63}$",
          "title": "Task Id",
          "type": "string"
        },
        "video_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,63}$",
          "title": "Video Id",
          "type": "string"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "succeeded",
            "partial",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/EvidenceEvent"
          },
          "title": "Events",
          "type": "array"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/ContentSegment"
          },
          "title": "Segments",
          "type": "array"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "original_revision": {
          "default": 1,
          "minimum": 1,
          "title": "Original Revision",
          "type": "integer"
        },
        "review": {
          "$ref": "#/$defs/ReviewState"
        },
        "corrections": {
          "items": {
            "$ref": "#/$defs/Correction"
          },
          "title": "Corrections",
          "type": "array"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "empty_result_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Empty Result Reason"
        }
      },
      "required": [
        "schema_version",
        "created_at",
        "updated_at",
        "analysis_id",
        "revision",
        "task_id",
        "video_id",
        "duration_seconds",
        "status",
        "events",
        "segments",
        "coverage",
        "origin",
        "original_revision",
        "review",
        "corrections",
        "error",
        "empty_result_reason"
      ],
      "title": "AnalysisResult",
      "type": "object"
    },
