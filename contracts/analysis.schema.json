{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,63}$"
    },
    "video_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,63}$"
    },
    "analysis_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed"
      ]
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_method": {
          "enum": [
            "file",
            "url"
          ]
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "original_file_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration_seconds": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "input_method",
        "source_url",
        "original_file_name",
        "duration_seconds"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "input_method": {
                "const": "url"
              }
            }
          },
          "then": {
            "properties": {
              "source_url": {
                "type": "string",
                "format": "uri",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "input_method": {
                "const": "file"
              }
            }
          },
          "then": {
            "properties": {
              "original_file_name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "public_metrics": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/metric_snapshot"
        }
      ]
    },
    "model_run": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "prompt_version": {
              "type": "string"
            }
          },
          "required": [
            "provider",
            "model",
            "prompt_version"
          ]
        }
      ]
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/segment"
      }
    },
    "empty_result_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "editor_type": {
          "enum": [
            "system",
            "model",
            "user"
          ]
        },
        "original_revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "user_confirmed": {
          "type": "boolean"
        },
        "confirmed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "editor_type",
        "original_revision",
        "user_confirmed",
        "confirmed_at"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "user_confirmed": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "confirmed_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "else": {
            "properties": {
              "confirmed_at": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ]
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "video_id",
    "analysis_id",
    "revision",
    "created_at",
    "updated_at",
    "status",
    "video",
    "public_metrics",
    "model_run",
    "segments",
    "empty_result_reason",
    "review",
    "error"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/video-anatomy/contracts/analysis-0.1.0.schema.json",
  "title": "PROPOSED Video Anatomy AnalysisResult v0.1.0",
  "$comment": "Proposal only. Synthetic examples are not model results. Cross-field time bounds, ID uniqueness, source matching, revision dependencies, and read-only midterm timestamps require semantic validation described in docs/interfaces.md. The example.invalid ID is an identifier, not a deployed endpoint.",
  "$defs": {
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "segment_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,63}$"
        },
        "start_seconds": {
          "type": "number",
          "minimum": 0
        },
        "end_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "hook",
              "product_demo",
              "proof",
              "cta",
              "other"
            ]
          }
        },
        "spoken_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "on_screen_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "visual_description": {
          "type": "string",
          "minLength": 1
        },
        "interpretation": {
          "type": [
            "string",
            "null"
          ]
        },
        "edited_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "roles",
              "spoken_text",
              "on_screen_text",
              "visual_description"
            ]
          }
        }
      },
      "required": [
        "segment_id",
        "start_seconds",
        "end_seconds",
        "roles",
        "spoken_text",
        "on_screen_text",
        "visual_description",
        "interpretation",
        "edited_fields"
      ]
    },
    "metric_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "views": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "likes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "comments": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "source_url",
        "captured_at",
        "views",
        "likes",
        "comments"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        }
      },
      "then": {
        "properties": {
          "video": {
            "properties": {
              "duration_seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "model_run": {
            "type": "object"
          },
          "review": {
            "properties": {
              "original_revision": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "segments": {
            "maxItems": 0
          },
          "empty_result_reason": {
            "type": "null"
          },
          "review": {
            "properties": {
              "user_confirmed": {
                "const": false
              },
              "confirmed_at": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          },
          "segments": {
            "maxItems": 0
          }
        }
      },
      "then": {
        "properties": {
          "empty_result_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "empty_result_reason": {
            "type": "null"
          }
        }
      }
    }
  ]
}
