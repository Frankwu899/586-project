{
  "name": "video-anatomy-web",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "preview": "vite preview --host 127.0.0.1",
    "contracts:generate": "node scripts/generate-contracts.mjs --write",
    "contracts:check": "node scripts/check-contracts.mjs",
    "test:e2e": "playwright test",
    "test:unit": "node --test tests/*.test.mjs",
    "test:e2e:providers": "playwright test --config playwright.providers.config.ts"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@playwright/test": "1.56.1",
    "@types/node": "24.9.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.38.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.4.0",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "7.1.12"
  }
}
