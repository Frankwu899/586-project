# Documentation of backend settings. Export needed values in the terminal
# before starting uvicorn; the application does not automatically read .env.
VIDEO_ANATOMY_DATA_DIR=.local-data
VIDEO_MAX_BYTES=524288000
VIDEO_MAX_DURATION_SECONDS=180
VIDEO_MAX_WIDTH=1920
VIDEO_MAX_HEIGHT=1920
VIDEO_PROBE_TIMEOUT_SECONDS=15
VIDEO_DECODE_TIMEOUT_SECONDS=60
VIDEO_TRANSCODE_TIMEOUT_SECONDS=180
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# Optional browser override; otherwise use an installed Playwright Chromium.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
# Sample tasks never call a paid provider. Ordinary real tasks use these
# backend settings; keys are not shipped to the frontend or committed.
# OPENAI_API_KEY=your-server-side-secret
VIDEO_VISION_PROVIDER=openai
VIDEO_TRANSCRIPTION_PROVIDER=openai
VIDEO_CREATIVE_PROVIDER=openai
# Optional M2 extraction is independent of creative generation; use disabled
# for manual-only input. Fake assistance is test injection only, never a fallback.
VIDEO_M2_PROVIDER=openai
OPENAI_VISION_MODEL=gpt-6.1-sol
# GPT-6 models do not accept audio. Existing transcripts remain available.
# Owner-approved speech exception; segment timestamps drive the Speech timeline.
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_CREATIVE_MODEL=gpt-6.1-sol
OPENAI_M2_MODEL=gpt-6.1-sol
OPENAI_STRUCTURE_MODEL=gpt-6.1-sol
# The local app pins all text/vision/research to Sol, ignoring stale model
# overrides. Direct backend/Cloud evaluation still supports explicit models.
OPENAI_RESEARCH_MODEL=gpt-6.1-sol
ANALYSIS_OUTPUT_LANGUAGE=English
CREATIVE_OUTPUT_LANGUAGE=English
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=8000
VIDEO_ANALYSIS_MAX_FRAMES=12
VIDEO_AUDIO_CHUNK_SECONDS=60
VIDEO_MAX_AUDIO_CHUNKS=3

# Local Finder/command launchers report usage without a client spending cap.
# The authorized USD 3 limit belongs only to Cloud experiments, not client use.
# The separately invoked live evaluation harness also requires a permitted,
# hashed clip manifest and verified pricing file. No budget is preauthorized.
RUN_LIVE_MODEL_TESTS=0
# LIVE_TEST_MAX_COST_USD=<explicit-positive-authorized-budget>
