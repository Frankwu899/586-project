FROM node:22-bookworm-slim AS frontend
WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock
COPY backend/ ./backend/
COPY scripts/ ./scripts/
COPY contracts/ ./contracts/
COPY data/ ./data/
COPY --from=frontend /build/frontend/dist ./frontend/dist/
RUN useradd --uid 10001 --create-home app && mkdir /data && chown app:app /data
# The entrypoint initializes mount ownership, then drops to UID 10001 before
# importing or running the web application.
ENV VIDEO_ANATOMY_DATA_DIR=/data/library PORT=8000 PYTHONUNBUFFERED=1
EXPOSE 8000
CMD ["python", "-m", "scripts.shared_container"]
